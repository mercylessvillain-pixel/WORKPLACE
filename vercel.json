{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/process-knowledge",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/recrawl",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/webhook-retries",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/operations",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "*/20 * * * *"
    }
  ]
}
