{
  "name": "workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Workbench \u2014 one place for the small jobs: files, images, PDFs, text, code and business paperwork.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-migrate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "check": "tsx scripts/check-setup.ts",
    "e2e": "node -e \"require('node:fs').rmSync('.e2e/pglite',{recursive:true,force:true})\" && playwright test",
    "e2e:server": "tsx scripts/db-migrate.ts && next start",
    "e2e:report": "playwright show-report .e2e/report",
    "ocr:assets": "tsx scripts/copy-ocr-assets.ts",
    "prebuild": "tsx scripts/copy-ocr-assets.ts && tsx scripts/verify-quality-ladder.ts",
    "predev": "tsx scripts/copy-ocr-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@breezystack/lamejs": "^1.2.7",
    "@cantoo/pdf-lib": "^2.11.1",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "^6.3.289",
    "postgres": "3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "2.6.0",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
