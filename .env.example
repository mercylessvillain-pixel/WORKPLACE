# ---------------------------------------------------------------------------
# AI Customer Service — environment variables
# Copy to .env.local for development. Set the same values in Vercel for prod.
# Never prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------

# PostgreSQL connection string. Must have the `vector` extension available
# (Supabase, Neon, RDS and most managed providers support pgvector).
# Leave empty in local development to use the bundled PGlite database.
#
# Supabase: Project Settings → Database → Connection string.
#   App (pooled, port 6543):  postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   Migrations (direct, 5432): postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Run `npm run check` after setting this to confirm the connection and pgvector.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Random 32+ character string. Signs session and API-key hashes.
#   openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# Random 32+ character string. Encrypts third-party credentials at rest.
#   openssl rand -base64 48
ENCRYPTION_KEY=replace-with-a-different-long-random-string

# Public base URL of the deployment (used in widget snippets and emails).
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- AI providers -----------------------------------------------------------
# Gemini is the primary provider, OpenAI is the automatic fallback.
# With neither key set, the app runs in clearly-labelled offline answering mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- File storage (optional) ------------------------------------------------
# S3-compatible storage for uploaded originals (AWS S3, Cloudflare R2,
# Supabase Storage, MinIO …).
# Without it, originals up to 8 MB are stored in PostgreSQL instead.
#
# Supabase Storage: create a private bucket, then Project Settings → Storage →
# S3 access keys. S3_ENDPOINT is https://<ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Leave empty to decide automatically (path style whenever S3_ENDPOINT is set).
S3_FORCE_PATH_STYLE=

# Not used: this app does not use the Supabase JS client, Supabase Auth or
# Supabase Realtime, so the project "anon" and "service_role" keys are not
# needed. Do not add them — an unused service_role key is a liability.

# --- Email channel (optional) -----------------------------------------------
# Outbound replies via Resend; inbound email posts to /api/webhooks/email.
RESEND_API_KEY=
EMAIL_FROM=support@yourdomain.com
INBOUND_EMAIL_SIGNING_SECRET=

# --- WhatsApp channel (optional) --------------------------------------------
# WhatsApp Business Platform (Meta Cloud API).
# Per-business phone number id and access token are entered in the dashboard.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Billing (optional) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
# Optional annual prices. Leave blank to offer monthly billing only.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=

# --- Sign in with Google (optional) -----------------------------------------
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# <APP URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Video downloader (optional) --------------------------------------------
# A Vimeo API access token with the "video_files" scope. With it, the video
# downloader can offer the download files Vimeo itself provides for videos the
# connected account is allowed to download. Without it, Vimeo links show public
# details only; nothing is faked and no access control is worked around.
VIMEO_ACCESS_TOKEN=

# --- Operations (optional) --------------------------------------------------
# Shared secret for every scheduled job (re-crawl, webhook retries, knowledge retry).
CRON_SECRET=
# Comma-separated emails that may open /admin.
ADMIN_EMAILS=

# Error monitoring (optional). Any Sentry-compatible DSN works.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Optional rate-limit tuning, for installations behind a shared IP address.
# Format: requests/seconds, e.g. RATE_LIMIT_SIGNUP="20/3600". Defaults are in
# src/lib/security/rate-limit.ts.
# RATE_LIMIT_SIGNUP=
# RATE_LIMIT_LOGIN=
